         nargs="?",
         default="all",
     )
     args = parser.parse_args()
+    if args.phase == "repeated-smoke":
+        run_spatial_repeated_trials(TRIAL_SEEDS[:2])
+        return
+    if args.phase == "repeated":
+        run_spatial_repeated_trials(TRIAL_SEEDS)
+        return
     context = load_frozen_context()
